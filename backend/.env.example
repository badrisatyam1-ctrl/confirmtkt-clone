# ===========================
# Application
# ===========================
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/travelbooking?schema=public

# ===========================
# Redis
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===========================
# JWT Secrets
# ===========================
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================
# Google OAuth
# ===========================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ===========================
# Stripe
# ===========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ===========================
# Twilio
# ===========================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===========================
# Firebase Admin SDK
# ===========================
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here_with_newlines"

# ===========================
# Email (Nodemailer)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here
SMTP_FROM="TravelBooking <noreply@travelbooking.com>"
